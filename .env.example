# ─── Supabase ──────────────────────────────────────────────────────────────────
# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only — NEVER expose, never import in client code
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ─── AI ────────────────────────────────────────────────────────────────────────
# Server-only — used by the Server Action that generates executive summaries.
# Do NOT prefix with NEXT_PUBLIC_. Current provider is OpenAI; swapping to a
# different provider only requires editing src/lib/ai/client.ts.
OPENAI_API_KEY=replace-me

# ─── App ───────────────────────────────────────────────────────────────────────
# Used by Supabase invite emails (redirectTo) and any absolute URL the app needs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret que Vercel Cron manda en `Authorization: Bearer <secret>` cuando dispara
# el cron diario de sync-integrations. Generá un string random largo y ponelo
# también en las env vars del proyecto en Vercel (Production + Preview).
CRON_SECRET=replace-me
