# ─── Supabase ──────────────────────────────────────────────────────────────────
# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only — NEVER expose, never import in client code
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ─── AI ────────────────────────────────────────────────────────────────────────
# Server-only — used by the Route Handler / Server Action that generates the
# executive summary. Do NOT prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=replace-me

# ─── App ───────────────────────────────────────────────────────────────────────
# Used by Supabase invite emails (redirectTo) and any absolute URL the app needs
NEXT_PUBLIC_APP_URL=http://localhost:3000
